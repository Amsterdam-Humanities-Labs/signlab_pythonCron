[Unit]
Description=Server Monitor (disk, rclone, mysql)
After=network.target mysql.service

[Service]
Type=simple
User=gomer
Group=gomer
WorkingDirectory=/home/gomer/pythonCron
ExecStart=/usr/bin/python3 /home/gomer/pythonCron/server_monitor.py
Restart=always
RestartSec=10

Environment=PYTHONUNBUFFERED=1

MemoryMax=256M
TasksMax=50

NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/home/gomer/pythonCron /web/gebarenoverleg_media/studioFiles /tmp
PrivateTmp=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# The journal (journalctl -u server-monitor), which rotates itself. This used
# to append: to server_monitor.log, which nothing reads and nothing rotated.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

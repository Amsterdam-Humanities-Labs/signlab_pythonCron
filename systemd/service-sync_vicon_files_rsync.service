[Unit]
Description=Rsyncs Vicon capture files from the Vicon PC
After=network.target

[Service]
Type=simple
User=gomer
WorkingDirectory=/home/gomer/pythonCron
ExecStart=/usr/bin/python3 /home/gomer/pythonCron/service_wrapper.py Sync_Vicon_Files_rsync
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Resource limits (optional, uncomment and adjust as needed)
# CPUQuota=50%
# MemoryMax=512M

[Install]
WantedBy=multi-user.target

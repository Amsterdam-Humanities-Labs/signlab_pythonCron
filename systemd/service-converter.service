[Unit]
Description=Converts media files
After=network.target

[Service]
Type=simple
User=gomer
WorkingDirectory=/home/gomer/pythonCron
ExecStart=/usr/bin/python3 /home/gomer/pythonCron/service_wrapper.py Converter
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

# Resource limits (optional, uncomment and adjust as needed)
# CPUQuota=50%
# MemoryMax=512M

[Install]
WantedBy=multi-user.target
